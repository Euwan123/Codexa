{
  "name": "codexa-github-manager",
  "private": true,
  "version": "0.1.0",
  "description": "A private desktop workspace for organizing GitHub repositories.",
  "author": "Codexa",
  "license": "MIT",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev",
    "build": "tsc -b && electron-vite build",
    "prebuild:win": "node scripts/check-github-client-id.mjs",
    "build:win": "npm run build && electron-builder --win nsis",
    "test": "node --experimental-strip-types --test src/shared/groups.test.ts",
    "lint": "oxlint src electron",
    "preview": "electron-vite preview"
  },
  "build": {
    "appId": "dev.codexa.githubmanager",
    "productName": "Codexa",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "dependencies": {
    "@octokit/rest": "^22.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "lucide-react": "^1.62.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "oxlint": "^1.89.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  }
}
